      "id": "d4894a0d-f8b9-4fec-9ca7-d6007b7d55d3",
      "name": "Get events (last 10 min)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        496,
        224
      ],
      "credentials": {
        "supabaseApi": {
          "id": "g7f1OZc8IRQrqEmL",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Thresholds').first().json;\nconst events = $input.all().map(i => i.json).filter(e => e && e.event_type);\nconst ipOf = e => e.ip_address || e.ip || '';\nconst emailOf = e => String(e.email || '').toLowerCase();\nconst ts = e => new Date(e.created_at).getTime();\nconst fmt = d => d.toLocaleString('ar-EG', { timeZone: 'Africa/Cairo', hour12: false });\nconst esc = v => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst uuidRe = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst emojis = { CRITICAL: '🔴', HIGH: '🟠' };\nconst admins = String(cfg.admin_user_ids || '').split(',').map(s => s.trim()).filter(Boolean);\nconst adminRoles = String(cfg.admin_roles || 'system_admin,admin').split(',').map(s => s.trim().toLowerCase()).filter(Boolean);\nconst incidents = [];\n\nconst groupBy = (arr, fn) => {\n  const m = new Map();\n  for (const x of arr) {\n    const k = fn(x);\n    if (!k) continue;\n    if (!m.has(k)) m.set(k, []);\n    m.get(k).push(x);\n  }\n  return m;\n};\nconst topIp = evs => {\n  const c = {};\n  evs.forEach(e => { const i = ipOf(e); if (i) c[i] = (c[i] || 0) + 1; });\n  return Object.keys(c).sort((a, b) => c[b] - c[a])[0] || '';\n};\nconst firstOf = (evs, fn) => {\n  for (const e of evs) { const v = fn(e); if (v) return v; }\n  return '';\n};\nconst add = (rule, severity, evs, subject, emailOverride, allowBlock = true) => {\n  const times = evs.map(ts).filter(t => !isNaN(t));\n  if (!times.length) return;\n  const start = new Date(Math.min(...times));\n  const end = new Date(Math.max(...times));\n  const resolvedUserId = firstOf(evs, e => e.target_user_id || e.user_id);\n  const canBlock = Boolean(allowBlock && uuidRe.test(String(resolvedUserId || '')));\n  incidents.push({ json: {\n    rule: esc(rule),\n    raw_rule: rule,\n    severity,\n    emoji: emojis[severity] || '🟠',\n    email: esc(emailOverride || firstOf(evs, emailOf) || 'n/a'),\n    ip: esc(topIp(evs) || 'n/a'),\n    user_id: resolvedUserId || '',\n    can_block: canBlock,\n    count: evs.length,\n    window_start: start.toISOString(),\n    window_end: end.toISOString(),\n    window_text: esc(fmt(start) + ' - ' + fmt(end) + ' (توقيت القاهرة)'),\n    event_ids: evs.map(e => e.id).filter(x => x !== undefined && x !== null),\n    dedup_key: rule + '|' + subject,\n  } });\n};\n\nconst failed = events.filter(e => e.event_type === 'login_failed');\n\n// Rule 1: 5+ failed logins for the same account\ngroupBy(failed, emailOf).forEach((evs, email) => {\n  if (evs.length >= cfg.failed_per_email) add('محاولات دخول فاشلة متكررة (نفس الحساب)', 'HIGH', evs, email);\n});\n\n// Rule 2: 10+ failed from one IP, or one IP hitting 3+ different accounts\ngroupBy(failed, ipOf).forEach((evs, ip) => {\n  if (evs.length >= cfg.failed_per_ip) add('محاولات دخول فاشلة متكررة (نفس الـ IP)', 'HIGH', evs, ip);\n  const emails = new Set(evs.map(emailOf).filter(Boolean));\n  if (emails.size >= cfg.emails_per_ip) {\n    add('IP واحد يستهدف حسابات متعددة', 'HIGH', evs, ip, emails.size + ' حساب مختلف');\n  }\n});\n\n// Rule 3: login_success right after 3+ failures for the same account (alert without auto-ban button so attackers cannot trigger bait lockouts)\nevents.filter(e => e.event_type === 'login_success').forEach(s => {\n  const prior = failed.filter(f => emailOf(f) === emailOf(s) && ts(f) < ts(s));\n  if (prior.length >= cfg.success_after_failed) {\n    add('تسجيل دخول ناجح بعد محاولات فاشلة', 'CRITICAL', prior.concat([s]), emailOf(s) + '|' + s.id, undefined, false);\n  }\n});\n\n// Rule 4: any role/permission change (extra critical if self or non-admin)\nevents.filter(e => e.event_type === 'role_change').forEach(e => {\n  const target = e.target_user_id || e.user_id;\n  const changer = e.changed_by;\n  const self = (e.details && e.details.audit_event_type === 'self_role_permission_change') || (!!changer && !!target && String(changer) === String(target));\n  const roleLower = String(e.changed_by_role || '').toLowerCase();\n  const adminKnown = admins.length > 0 || (e.changed_by_role !== undefined && e.changed_by_role !== null);\n  const isAdmin = adminRoles.includes(roleLower) || admins.includes(String(changer));\n  if (self) add('المستخدم غيّر دوره بنفسه', 'CRITICAL', [e], 'self|' + e.id, undefined, true);\n  else if (adminKnown && !isAdmin) add('تغيير دور بواسطة مستخدم غير أدمن', 'CRITICAL', [e], 'nonadmin|' + e.id, undefined, true);\n  else add('تغيير دور أو صلاحيات مستخدم (بواسطة أدمن)', 'CRITICAL', [e], 'adminrole|' + e.id, undefined, false);\n});\n\n// Rule 5: 3+ access_denied for the same user (or 1+ immediate cross-user/access violation)\ngroupBy(events.filter(e => e.event_type === 'access_denied'), e => e.user_id || emailOf(e) || ipOf(e)).forEach((evs, who) => {\n  if (evs.length >= cfg.denied_per_user) add('رفض وصول متكرر', 'HIGH', evs, who);\n});\n\n// Rule 6: Mass delete (immediately CRITICAL)\nevents.filter(e => e.event_type === 'mass_delete').forEach(e => {\n  add('حذف جماعي غير معتاد (Mass Delete)', 'CRITICAL', [e], 'massdel|' + e.id, undefined, true);\n});\n\n// Rule 7: Login from new IP or unusual hours\nevents.filter(e => e.event_type === 'login_anomaly').forEach(e => {\n  add('تسجيل دخول من IP جديد أو في وقت غير معتاد', 'HIGH', [e], 'anomaly|' + e.id, undefined, false);\n});\n\nreturn incidents;"
      },
      "id": "25bb0b37-3f96-401e-92fc-fdc9ba72e155",
      "name": "Detect Incidents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        224
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Thresholds').first().json;\nconst store = $getWorkflowStaticData('global');\nstore.sent = store.sent || {};\nconst now = Date.now();\nconst ttl = cfg.dedupe_minutes * 60000;\nfor (const k of Object.keys(store.sent)) {\n  if (now - store.sent[k] > ttl) delete store.sent[k];\n}\nconst out = [];\nfor (const item of $input.all()) {\n  const k = item.json.dedup_key;\n  if (store.sent[k]) continue;\n  store.sent[k] = now;\n  out.push(item);\n}\nreturn out;"
      },
      "id": "a3ee57da-7e98-4d0b-a999-790a14dfe125",
