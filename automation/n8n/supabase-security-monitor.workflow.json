    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(e => e && e.event_type);\nconst esc = v => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst ipOf = e => e.ip_address || e.ip || '';\nconst byType = t => rows.filter(e => e.event_type === t);\nconst failed = byType('login_failed');\nconst denied = byType('access_denied');\nconst roleChanges = byType('role_change');\nconst massDeletes = byType('mass_delete');\nconst anomalies = byType('login_anomaly');\nconst top = (arr, fn, n) => {\n  const c = {};\n  arr.forEach(e => { const k = fn(e); if (k) c[k] = (c[k] || 0) + 1; });\n  return Object.keys(c).sort((a, b) => c[b] - c[a]).slice(0, n).map(k => ({ key: k, count: c[k] }));\n};\nconst topIps = top(rows, ipOf, 5);\nconst topFailedIps = top(failed, ipOf, 5);\nconst topDeniedUsers = top(denied, e => e.email || e.user_id, 5);\nconst roleList = roleChanges.map(e => ({ target: e.target_user_id || e.user_id || e.email, changed_by: e.changed_by, changed_by_role: e.changed_by_role, new_role: e.new_role, at: e.created_at }));\nconst line = list => list.length ? esc(list.map(x => x.key + ' (' + x.count + ')').join(', ')) : 'لا يوجد';\nconst facts = [\n  '<b>آخر 24 ساعة</b>',\n  'إجمالي الأحداث: ' + rows.length,\n  'محاولات الدخول الفاشلة: ' + failed.length,\n  'تسجيلات الدخول الناجحة: ' + byType('login_success').length,\n  'تنبيهات الدخول غير المعتاد: ' + anomalies.length,\n  'أكثر الـ IP نشاطاً: ' + line(topIps),\n  'أكثر الـ IP في الفشل: ' + line(topFailedIps),\n  'تغييرات الأدوار: ' + roleChanges.length,\n  'عمليات الحذف الجماعي: ' + massDeletes.length,\n  'حالات رفض الوصول: ' + denied.length + ' | أكثر المستخدمين: ' + line(topDeniedUsers),\n].join('\\n');\nconst report = {\n  total_events: rows.length,\n  failed_logins: failed.length,\n  successful_logins: byType('login_success').length,\n  login_anomalies: anomalies.length,\n  mass_deletes: massDeletes.length,\n  top_ips: topIps,\n  top_failed_login_ips: topFailedIps,\n  role_changes: roleList.slice(0, 20),\n  access_denials: denied.length,\n  top_denied_users: topDeniedUsers,\n};\nreturn [{ json: { facts_text: facts, report_data: JSON.stringify(report) } }];"
      },
