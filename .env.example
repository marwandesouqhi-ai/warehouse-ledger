# ==============================================================================
# إعدادات واجهة المستخدم الأمامية (Frontend Vite Environment Variables)
# ==============================================================================

# رابط مشروع Supabase (مثال: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# المفتاح العام لـ Supabase (Publishable Key / Anon Key)
VITE_SUPABASE_PUBLISHABLE_KEY=

# بديل اختياري للمفتاح العام
VITE_SUPABASE_ANON_KEY=

# وضع المصادقة (transitional أو secure)
# transitional: يدعم تسجيل الدخول بالمعرف الوظيفي والبريد عبر login-bridge الآمن
# secure: يقتصر على Supabase Auth المباشر عبر البريد وكلمة المرور
VITE_AUTH_MODE=transitional

# ==============================================================================
# إعدادات دوال الخادم السحابية (Supabase Edge Functions Configuration)
# يتم ضبط هذه المتغيرات في: Supabase Dashboard > Project Settings > Secrets
# تحذير أمني: لا تضع أي أسرار إنتاجية في هذا الملف أبداً!
# ==============================================================================

# عنوان Supabase ومفاتيح الوصول للدوال (تُحقن تلقائياً في بيئة Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# سر تشفير بصمة رموز OTP في الخادم (Server-Side OTP Pepper)
OTP_PEPPER=

# هوية مدير النظام المعتمد لعملية التهيئة الأحادية (Session A Bootstrap)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=

# رابط التطبيق المنشور (لتضمينه في روابط التفعيل والاستعادة)
APP_BASE_URL=

# ==============================================================================
# إعدادات بوت تيليجرام لتسجيل الموظفين (Telegram Bot Configuration)
# ==============================================================================

# توكن بوت تيليجرام من BotFather
TELEGRAM_BOT_TOKEN=

# سر التحقق من توقيع طلبات الويب هوك (مطلوب fail-closed)
TELEGRAM_WEBHOOK_SECRET=

# معرف محادثة المشرف المعتمد لإشعارات طلبات التسجيل الجديدة (اختياري)
TELEGRAM_ADMIN_CHAT_ID=

# ==============================================================================
# إعدادات خدمة إرسال البريد الإلكتروني (Email Delivery - Resend & SMTP/Gmail)
# ==============================================================================

# عنوان البريد المرسل المعروض للمستلم
EMAIL_FROM=
RESEND_FROM_EMAIL=

# مزود Resend API (إذا تم اختياره)
RESEND_API_KEY=

# مزود البريد عبر خادم SMTP أو بريد Gmail (إذا تم اختياره)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
GMAIL_USER=
GMAIL_APP_PASSWORD=
