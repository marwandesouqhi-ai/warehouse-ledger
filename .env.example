VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# وضع المصادقة:
# - 'transitional' (الافتراضي): يعتمد على Supabase Auth ويوفر login-bridge آمن ومحدد المعدل (rate-limited) لتسجيل الدخول باسم المستخدم أو الكود الوظيفي (Unique ID)
# - 'secure': يقتصر على Supabase Auth المباشر عبر البريد الإلكتروني
# ملاحظة هامة: الوضع المحلي القديم 'legacy' تم حذفه عمداً لتعزيز الأمان.
VITE_AUTH_MODE=transitional

# ==============================================================================
# إعدادات دوال الخادم وبوت تيليجرام (Supabase Edge Functions & Telegram Bot)
# ملاحظة أمنية: يتم ضبط هذه المتغيرات في لوحة تحكم Supabase > Project Settings > Secrets
# ولا يجوز تضمينها مطلقاً في واجهة العميل أو كود المتصفح الأمامي!
# ==============================================================================

# مفتاح الخدمة الخاص بـ Supabase (Service Role Key - سري جداً):
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# إعدادات بوت تسجيل الموظفين عبر تيليجرام (Telegram Bot Configuration):
# TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_WEBHOOK_SECRET=your_cryptographically_secure_webhook_secret_here
# TELEGRAM_WEBHOOK_URL=https://your-project.supabase.co/functions/v1/telegram-bot

# رابط التطبيق الأمامي المنشور (لإعادة التوجيه ورسائل البريد الإلكتروني):
# APP_BASE_URL=https://your-app-domain.com

# هوية مدير النظام الرئيسي المعتمدة للتهيئة الأحادية (Server-Side Bootstrap Identity):
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_USERNAME=

# مزود خدمة إرسال البريد الإلكتروني للتحقق (Email Verification Provider):
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_1234567890abcdef
# EMAIL_FROM=Warehouse Ledger <noreply@yourdomain.com>

# سر تشفير وحماية رموز التحقق في الخادم (Server-Side OTP Pepper):
# OTP_PEPPER=your_random_cryptographic_pepper_here


